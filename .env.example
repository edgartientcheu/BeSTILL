# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Values starting with EXPO_PUBLIC_ are visible in the browser. Only put public keys there.

# Supabase (step 3): Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (step 4): Developers → API keys (use the TEST key, starts with pk_test_)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY)
# never go in this file. They are stored in Supabase as Edge Function secrets (see README).
